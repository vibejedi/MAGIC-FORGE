# Copy to deploy/.env and fill in. Never commit the real file.

# Website domain. Point an A record (IPv4 only, no AAAA) at the VPS so the website and
# Forge both see players' IPv4 address.
DOMAIN=play.example.com
# What players type into Forge's Join dialog: the same domain or the VPS's IPv4 address.
PUBLIC_HOST=play.example.com
PUBLIC_ORIGIN=https://play.example.com

# openssl rand -hex 32  (one value for each)
GAME_SERVER_SECRET=
ADMIN_TOKEN=

# Anti-abuse
MIN_TURNS_FOR_RANKED=4
MAX_RANKED_PER_PAIR_PER_DAY=2
# Games vs the AI: only this many ranked per player per 24h; rating moves against a fixed AI_RATING.
MAX_AI_RANKED_PER_DAY=5
AI_RATING=1400
ARM_TTL_MINUTES=15
MIN_ACCOUNT_AGE_HOURS_TO_CLAIM=24
FORGE_MAX_MATCH_MINUTES=90

# Payouts: start with manual + dry-run. Switch to live only after testing on devnet.
CLAIM_MODE=manual
PAYOUT_MODE=dry-run
REWARD_TOKEN_SYMBOL=REWARD
REWARD_DECIMALS=6
ACCOUNT_DAILY_CAP=500
GLOBAL_DAILY_CAP=10000
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
REWARD_MINT=
TREASURY_SECRET_KEY=

# Forge JVM heap per server. ~1.5 GB each; a 8 GB VPS runs 3 servers comfortably.
JAVA_OPTS=-Xmx1536m
