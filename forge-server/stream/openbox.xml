<?xml version="1.0" encoding="UTF-8"?>
<!-- Forge's main window fills the virtual screen without borders; dialogs keep their size. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application class="*" type="normal">
      <decor>no</decor>
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
