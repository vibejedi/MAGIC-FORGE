index 00000000..26ede1a7
--- /dev/null
+++ b/forge-gui-desktop/src/main/java/forge/server/RewardsClient.java
@@ -0,0 +1,123 @@
+package forge.server;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonObject;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.HexFormat;
+import java.util.Map;
+import java.util.stream.Stream;
+
+/**
+ * Talks to the rewards service. Every request is signed with the shared game-server secret:
+ * header X-Signature = hex(HMAC-SHA256(secret, timestamp + "." + body)).
+ */
+final class RewardsClient {
+    private static final Gson GSON = new Gson();
+
+    private final String baseUrl;
+    private final byte[] secret;
+    private final Path spoolDir;
+    private final HttpClient http = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(3)).build();
+
+    RewardsClient(final String baseUrl, final String secret, final Path spoolDir) {
+        this.baseUrl = baseUrl.replaceAll("/+$", "");
+        this.secret = secret.getBytes(StandardCharsets.UTF_8);
+        this.spoolDir = spoolDir;
+    }
+
+    /** @return null if the player may sit down, otherwise the reason to show them. */
+    String loginCheck(final String username, final String ip) {
+        try {
+            final JsonObject res = post("/api/gs/login-check", Map.of("username", username, "ip", ip));
+            if (res.has("ok") && res.get("ok").getAsBoolean()) {
+                return null;
+            }
+            return res.has("reason") ? res.get("reason").getAsString() : "Login refused.";
+        } catch (final Exception e) {
+            System.err.println("[rewards] login check failed: " + e);
+            return "Ranked server cannot reach the rewards service right now. Try again in a minute.";
+        }
+    }
+
+    void heartbeat(final Map<String, Object> body) {
+        try {
+            post("/api/gs/heartbeat", body);
+        } catch (final Exception e) {
+            System.err.println("[rewards] heartbeat failed: " + e);
+        }
+    }
+
+    /**
+     * Writes the result to disk first, then sends it. Anything still on disk (because the
+     * rewards service was down) is re-sent by {@link #flushSpool()} on the next start.
+     */
+    void reportMatch(final String matchId, final Map<String, Object> body) throws IOException {
+        Files.createDirectories(spoolDir);
+        final Path file = spoolDir.resolve(matchId + ".json");
+        Files.writeString(file, GSON.toJson(body));
+        sendSpooled(file);
+    }
+
+    void flushSpool() {
+        if (!Files.isDirectory(spoolDir)) {
+            return;
+        }
+        try (Stream<Path> files = Files.list(spoolDir)) {
+            files.filter(f -> f.toString().endsWith(".json")).forEach(this::sendSpooled);
+        } catch (final IOException e) {
+            System.err.println("[rewards] cannot read spool: " + e);
+        }
+    }
+
+    private void sendSpooled(final Path file) {
+        try {
+            final String body = Files.readString(file);
+            final JsonObject res = postRaw("/api/gs/match-result", body);
+            System.out.println("[rewards] match reported: " + res);
+            Files.deleteIfExists(file);
+        } catch (final Exception e) {
+            System.err.println("[rewards] match report kept for retry (" + file.getFileName() + "): " + e);
+        }
+    }
+
+    private JsonObject post(final String path, final Object body) throws IOException, InterruptedException {
+        return postRaw(path, GSON.toJson(body));
+    }
+
+    private JsonObject postRaw(final String path, final String body) throws IOException, InterruptedException {
+        final String ts = Long.toString(System.currentTimeMillis() / 1000);
+        final HttpRequest req = HttpRequest.newBuilder(URI.create(baseUrl + path))
+                .timeout(Duration.ofSeconds(5))
+                .header("content-type", "application/json")
+                .header("x-timestamp", ts)
+                .header("x-signature", sign(ts + "." + body))
+                .POST(HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8))
+                .build();
+        final HttpResponse<String> res = http.send(req, HttpResponse.BodyHandlers.ofString());
+        if (res.statusCode() / 100 != 2) {
+            throw new IOException("HTTP " + res.statusCode() + " from " + path + ": " + res.body());
+        }
+        return GSON.fromJson(res.body(), JsonObject.class);
+    }
+
+    private String sign(final String payload) {
+        try {
+            final Mac mac = Mac.getInstance("HmacSHA256");
+            mac.init(new SecretKeySpec(secret, "HmacSHA256"));
+            return HexFormat.of().formatHex(mac.doFinal(payload.getBytes(StandardCharsets.UTF_8)));
+        } catch (final Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
