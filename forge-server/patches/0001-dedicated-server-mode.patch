+package forge.gamemodes.net.server;
+
+import java.net.SocketAddress;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Switches that turn the normal player-hosted server into a dedicated server with no
+ * local player. Everything here is inert unless {@link #dedicated} is set, so ordinary
+ * desktop/mobile hosting behaves exactly as before.
+ */
+public final class DedicatedHooks {
+    private DedicatedHooks() { }
+
+    /** Decides whether a connecting player may take a seat. */
+    public interface LoginGate {
+        /** @return null to admit the player, otherwise the reason shown to them before disconnecting */
+        String check(String username, SocketAddress remoteAddress);
+    }
+
+    /** When true the lobby has no LOCAL host seat and players may not rename themselves. */
+    public static volatile boolean dedicated = false;
+
+    /** Consulted for every login, including reconnects. Null admits everyone. */
+    public static volatile LoginGate loginGate = null;
+
+    /** Usernames whose seat was handed to the AI after they failed to reconnect in time. */
+    public static final Set<String> leavers = ConcurrentHashMap.newKeySet();
+}
