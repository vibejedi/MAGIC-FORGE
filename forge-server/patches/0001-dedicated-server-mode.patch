new file mode 100644
index 00000000..91ae3140
--- /dev/null
+++ b/forge-gui-desktop/src/main/java/forge/server/DedicatedServer.java
@@ -0,0 +1,279 @@
+package forge.server;
+
+import forge.game.GameOutcome;
+import forge.game.Match;
+import forge.gamemodes.match.GameLobby.GameLobbyData;
+import forge.gamemodes.match.HostedMatch;
+import forge.gamemodes.match.LobbySlot;
+import forge.gamemodes.match.LobbySlotType;
+import forge.gamemodes.net.ChatMessage;
+import forge.gamemodes.net.event.MessageEvent;
+import forge.gamemodes.net.server.DedicatedHooks;
+import forge.gamemodes.net.server.FServerManager;
+import forge.gamemodes.net.server.ServerGameLobby;
+import forge.gamemodes.net.client.ClientGameLobby;
+import forge.gui.GuiBase;
+import forge.interfaces.ILobbyListener;
+import forge.interfaces.IUpdateable;
+import forge.localinstance.properties.ForgeConstants;
+import forge.localinstance.properties.ForgeNetPreferences;
+import forge.localinstance.properties.ForgePreferences.FPref;
+import forge.model.FModel;
+
+import java.net.InetSocketAddress;
+import java.net.SocketAddress;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * {@code forge server}: hosts one 1v1 lobby with no local player, gates logins through the
+ * rewards service, starts the match once both remote players are ready, reports the result,
+ * then exits so the process supervisor (systemd/docker) restarts it with a clean lobby.
+ *
+ * <p>Configuration comes from environment variables:
+ * <ul>
+ *   <li>FORGE_SERVER_ID: name shown on the website, e.g. "eu-1" (required)</li>
+ *   <li>FORGE_PUBLIC_ADDRESS: host:port players type into Forge's Join dialog (required)</li>
+ *   <li>FORGE_PORT: port to listen on (default 36743)</li>
+ *   <li>REWARDS_URL: base URL of the rewards service (required)</li>
+ *   <li>GAME_SERVER_SECRET: shared HMAC secret (required)</li>
+ *   <li>FORGE_MAX_MATCH_MINUTES: abandon a match that runs longer (default 90)</li>
+ *   <li>FORGE_RANKED_LOGIN_GATE: set to "off" only for local testing without the rewards service</li>
+ * </ul>
+ */
+public final class DedicatedServer {
+    private static final int HEARTBEAT_SECONDS = 15;
+    private static final int EXIT_GRACE_SECONDS = 120;
+
+    private final String serverId = require("FORGE_SERVER_ID");
+    private final String publicAddress = require("FORGE_PUBLIC_ADDRESS");
+    private final int port = Integer.parseInt(env("FORGE_PORT", "36743"));
+    private final long maxMatchMillis = TimeUnit.MINUTES.toMillis(Long.parseLong(env("FORGE_MAX_MATCH_MINUTES", "90")));
+    private final boolean gateEnabled = !"off".equalsIgnoreCase(env("FORGE_RANKED_LOGIN_GATE", "on"));
+
+    private final ScheduledExecutorService loop = Executors.newSingleThreadScheduledExecutor(r -> {
+        final Thread t = new Thread(r, "dedicated-server");
+        t.setDaemon(false);
+        return t;
+    });
+
+    private RewardsClient rewards;
+    private FServerManager server;
+    private ServerGameLobby lobby;
+
+    private String matchId;
+    private long matchStartedAt;
+    private List<String> seatedPlayers = List.of();
+    private boolean reported;
+    private long lastHeartbeat;
+    private boolean startRefusedNotified;
+
+    public static void run(final String[] args) {
+        new DedicatedServer().start();
+    }
+
+    private void start() {
+        GuiBase.setInterface(new HeadlessServerGui());
+        FModel.initialize(null, prefs -> {
+            prefs.setPref(FPref.UI_MATCHES_PER_GAME, "1");   // one game per match: one result per report
+            prefs.setPref(FPref.ENFORCE_DECK_LEGALITY, true);
+            prefs.setPref(FPref.DEV_MODE_ENABLED, false);
+            FModel.getNetPreferences().setPref(ForgeNetPreferences.FNetPref.UPnP, "NEVER");
+            return null;
+        });
+
+        rewards = new RewardsClient(require("REWARDS_URL"), require("GAME_SERVER_SECRET"),
+                Path.of(ForgeConstants.USER_DIR, "pending-results"));
+        rewards.flushSpool();
+
+        DedicatedHooks.dedicated = true;
+        DedicatedHooks.leavers.clear();
+        if (gateEnabled) {
+            DedicatedHooks.loginGate = this::checkLogin;
+        } else {
+            System.out.println("WARNING: login gate is OFF. Anyone can join under any name. Results are still reported.");
+        }
+
+        server = FServerManager.getInstance();
+        lobby = new ServerGameLobby();
+        server.startServer(port);
+        server.setLobby(lobby);
+        lobby.setListener(new IUpdateable() {
+            @Override public void update(final boolean fullUpdate) { server.updateLobbyState(); }
+            @Override public void update(final int slot, final LobbySlotType type) { }
+        });
+        server.setLobbyListener(new ILobbyListener() {
+            @Override public void message(final String source, final String message, final ChatMessage.MessageType type) {
+                System.out.println("[chat] " + (source == null ? "" : source + ": ") + message);
+            }
+            @Override public void update(final GameLobbyData state, final int slot) { }
+            @Override public void close() { }
+            @Override public ClientGameLobby getLobby() { return null; }
+        });
+
+        System.out.printf("Dedicated server %s listening on %d (players connect to %s)%n", serverId, port, publicAddress);
+        loop.scheduleWithFixedDelay(this::tick, 1, 1, TimeUnit.SECONDS);
+    }
+
+    private String checkLogin(final String username, final SocketAddress remote) {
+        final String ip = remote instanceof InetSocketAddress inet && inet.getAddress() != null
+                ? inet.getAddress().getHostAddress() : String.valueOf(remote);
+        for (int i = 0; i < lobby.getNumberOfSlots(); i++) {
+            final LobbySlot s = lobby.getSlot(i);
+            if (s.getType() == LobbySlotType.REMOTE && username.equalsIgnoreCase(s.getName()) && !server.isMatchActive()) {
+                return "That player is already seated on this server.";
+            }
+        }
+        return rewards.loginCheck(username, ip);
+    }
+
+    private void tick() {
+        try {
+            final HostedMatch hosted = lobby.getHostedMatch();
+            if (hosted == null && matchId == null) {
+                maybeStartMatch();
+            } else if (hosted != null && matchId != null && !reported) {
+                watchMatch(hosted);
+            }
+            if (System.currentTimeMillis() - lastHeartbeat > HEARTBEAT_SECONDS * 1000L) {
+                lastHeartbeat = System.currentTimeMillis();
+                sendHeartbeat();
+            }
+        } catch (final Throwable t) {
+            System.err.println("[server] tick failed");
+            t.printStackTrace();
+        }
+    }
+
+    private List<LobbySlot> remoteSlots() {
+        final List<LobbySlot> out = new ArrayList<>();
+        for (int i = 0; i < lobby.getNumberOfSlots(); i++) {
+            final LobbySlot s = lobby.getSlot(i);
+            if (s.getType() == LobbySlotType.REMOTE) {
+                out.add(s);
+            }
+        }
+        return out;
+    }
+
+    private void maybeStartMatch() {
+        final List<LobbySlot> seats = remoteSlots();
+        if (seats.size() < 2 || !seats.stream().allMatch(LobbySlot::isReady)) {
+            startRefusedNotified = false;
+            return;
+        }
+        final Runnable start = lobby.startGame();
+        if (start == null) {
+            if (!startRefusedNotified) {
+                startRefusedNotified = true;
+                server.broadcast(MessageEvent.warning(
+                        "Match could not start: both players need a legal Constructed deck. Fix your deck and press Ready again."));
+                for (final LobbySlot s : seats) {
+                    s.setIsReady(false);
+                }
+                server.updateLobbyState();
+            }
+            return;
+        }
+        matchId = UUID.randomUUID().toString();
+        matchStartedAt = System.currentTimeMillis();
+        seatedPlayers = seats.stream().map(LobbySlot::getName).toList();
+        DedicatedHooks.leavers.clear();
+        System.out.printf("[match %s] starting: %s%n", matchId, seatedPlayers);
+        start.run();
+        server.broadcast(new MessageEvent("Ranked match " + matchId.substring(0, 8) + " started. Good luck!"));
+    }
+
+    private void watchMatch(final HostedMatch hosted) {
+        final Match match = hosted.getMatch();
+        final boolean over = match != null && match.isMatchOver();
+        final boolean timedOut = System.currentTimeMillis() - matchStartedAt > maxMatchMillis;
+        if (!over && !timedOut) {
+            return;
+        }
+        reported = true;
+        if (over) {
+            report(match);
+        } else {
+            System.out.printf("[match %s] exceeded %d minutes, abandoned without a result%n",
+                    matchId, TimeUnit.MILLISECONDS.toMinutes(maxMatchMillis));
+            server.broadcast(MessageEvent.warning("Match time limit reached. This match does not count."));
+        }
+        server.broadcast(new MessageEvent("This server restarts for the next match once both players leave the result screen."));
+        final long deadline = System.currentTimeMillis() + EXIT_GRACE_SECONDS * 1000L;
+        loop.scheduleWithFixedDelay(() -> {
+            // Players leave by quitting from the result screen (the match closes) or disconnecting
+            final boolean everyoneLeft = lobby.getHostedMatch() == null || remoteSlots().isEmpty();
+            if (everyoneLeft || System.currentTimeMillis() > deadline) {
+                System.out.println("[server] match finished, exiting for restart");
+                server.stopServer();
+                System.exit(0);
+            }
+        }, 2, 2, TimeUnit.SECONDS);
+    }
+
+    private void report(final Match match) {
+        GameOutcome last = null;
+        for (final GameOutcome o : match.getOutcomes()) {
+            last = o;
+        }
+        String winner = null;
+        int turns = 0;
+        if (last != null) {
+            turns = last.getLastTurnNumber();
+            if (!last.isDraw() && last.getWinningLobbyPlayer() != null) {
+                winner = last.getWinningLobbyPlayer().getName();
+            }
+        }
+        final List<Map<String, Object>> players = new ArrayList<>();
+        for (final String name : seatedPlayers) {
+            final Map<String, Object> p = new LinkedHashMap<>();
+            p.put("username", name);
+            p.put("leaver", DedicatedHooks.leavers.contains(name));
+            players.add(p);
+        }
+        final Map<String, Object> body = new LinkedHashMap<>();
+        body.put("matchId", matchId);
+        body.put("serverId", serverId);
+        body.put("players", players);
+        body.put("winner", winner);
+        body.put("turns", turns);
+        body.put("durationSec", (System.currentTimeMillis() - matchStartedAt) / 1000);
+        System.out.printf("[match %s] over: winner=%s turns=%d leavers=%s%n", matchId, winner, turns, DedicatedHooks.leavers);
+        try {
+            rewards.reportMatch(matchId, body);
+        } catch (final Exception e) {
+            System.err.println("[match " + matchId + "] could not spool result: " + e);
+        }
+    }
+
+    private void sendHeartbeat() {
+        final Map<String, Object> body = new LinkedHashMap<>();
+        body.put("serverId", serverId);
+        body.put("address", publicAddress);
+        body.put("status", matchId != null ? "playing" : remoteSlots().size() >= 2 ? "full" : "waiting");
+        body.put("players", remoteSlots().stream().map(LobbySlot::getName).toList());
+        rewards.heartbeat(body);
+    }
+
+    private static String env(final String name, final String fallback) {
+        final String v = System.getenv(name);
+        return v == null || v.isBlank() ? fallback : v.trim();
+    }
+
+    private static String require(final String name) {
+        final String v = env(name, null);
+        if (v == null) {
+            System.err.println("Missing required environment variable " + name);
+            System.exit(2);
+        }
+        return v;
+    }
+}
