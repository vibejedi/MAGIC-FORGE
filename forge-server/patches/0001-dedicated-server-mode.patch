diff --git a/forge-gui-desktop/src/test/java/forge/net/DedicatedServerSmoke.java b/forge-gui-desktop/src/test/java/forge/net/DedicatedServerSmoke.java
new file mode 100644
index 00000000..96f9b19b
--- /dev/null
+++ b/forge-gui-desktop/src/test/java/forge/net/DedicatedServerSmoke.java
@@ -0,0 +1,70 @@
+package forge.net;
+
+import forge.deck.Deck;
+import forge.gamemodes.net.event.UpdateLobbyPlayerEvent;
+import forge.interfaces.IGameController;
+
+import java.lang.reflect.Field;
+
+/**
+ * Manual smoke test for {@code forge server}: two scripted players join a running dedicated
+ * server, ready up with legal 60-card decks, and the first one concedes once the game starts.
+ *
+ * <pre>
+ *   java -cp ... forge.net.DedicatedServerSmoke host port nameA nameB
+ * </pre>
+ * Exit code 0 means both players were seated and the game started; verify the reported
+ * result on the rewards service.
+ */
+public final class DedicatedServerSmoke {
+    public static void main(final String[] args) throws Exception {
+        final String host = args[0];
+        final int port = Integer.parseInt(args[1]);
+        TestUtils.ensureFModelInitialized();
+
+        try (HeadlessNetworkClient a = new HeadlessNetworkClient(args[2], host, port);
+             HeadlessNetworkClient b = new HeadlessNetworkClient(args[3], host, port)) {
+            for (final HeadlessNetworkClient c : new HeadlessNetworkClient[] {a, b}) {
+                if (!c.connect(15_000)) {
+                    System.err.println("SMOKE: connect failed");
+                    System.exit(1);
+                }
+                Thread.sleep(500);
+                final Deck deck = TestDeckLoader.createMinimalDeck("Forest", 60);
+                c.getClient().send(UpdateLobbyPlayerEvent.deckUpdate(deck));
+                Thread.sleep(500);
+                c.setReady();
+            }
+            if (!a.waitForGameStart(60_000) || !b.waitForGameStart(60_000)) {
+                System.err.println("SMOKE: game did not start");
+                System.exit(1);
+            }
+            System.out.println("SMOKE: game started, " + args[2] + " concedes");
+            Thread.sleep(3_000);
+            // concede() can block until the server answers, so don't let it hold up the check
+            final Thread conceder = new Thread(() -> {
+                try {
+                    concede(a);
+                } catch (final Exception e) {
+                    e.printStackTrace();
+                }
+            }, "smoke-concede");
+            conceder.setDaemon(true);
+            conceder.start();
+            // The scripted clients never press Quit on the result screen, so instead of waiting for
+            // the match to close, check the result on the rewards service (GET /api/leaderboard).
+            Thread.sleep(10_000);
+            System.out.println("SMOKE: conceded; the server should now report " + args[3] + " as the winner");
+            System.exit(0);
+        }
+    }
+
+    private static void concede(final HeadlessNetworkClient client) throws Exception {
+        final Field guiField = HeadlessNetworkClient.class.getDeclaredField("guiGame");
+        guiField.setAccessible(true);
+        final Object gui = guiField.get(client);
+        final Field ctrlField = gui.getClass().getDeclaredField("gameController");
+        ctrlField.setAccessible(true);
+        ((IGameController) ctrlField.get(gui)).concede();
+    }
+}
diff --git a/forge-gui/src/main/java/forge/gamemodes/net/server/DedicatedHooks.java b/forge-gui/src/main/java/forge/gamemodes/net/server/DedicatedHooks.java
