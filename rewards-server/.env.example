# --- HTTP ---
# Listen on localhost only; Caddy terminates HTTPS and forwards to it.
HOST=127.0.0.1
PORT=8080
# Set to 1 when running behind Caddy/nginx so the client IP is read from X-Forwarded-For.
TRUST_PROXY=1
PUBLIC_ORIGIN=https://play.example.com

# --- Storage ---
DATABASE_PATH=./data/rewards.db
GOALS_PATH=./config/goals.json

# --- Secrets (generate with: openssl rand -hex 32) ---
# Shared with every Forge dedicated server process; signs login checks, heartbeats and match results.
GAME_SERVER_SECRET=
# Bearer token for /api/admin/* endpoints.
ADMIN_TOKEN=

# --- Anti-abuse ---
MIN_TURNS_FOR_RANKED=4
MAX_RANKED_PER_PAIR_PER_DAY=2
ARM_TTL_MINUTES=15
MIN_ACCOUNT_AGE_HOURS_TO_CLAIM=24

# --- Payouts ---
# manual = every claim waits for admin approval; auto = claims are paid as soon as they pass the caps.
CLAIM_MODE=manual
# dry-run = never touches the chain (records a fake signature); live = sends SPL token transfers.
PAYOUT_MODE=dry-run
REWARD_TOKEN_SYMBOL=REWARD
REWARD_DECIMALS=6
# Max whole tokens one account can claim per rolling 24h, and for all accounts together.
ACCOUNT_DAILY_CAP=500
GLOBAL_DAILY_CAP=10000

# Required when PAYOUT_MODE=live
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
REWARD_MINT=
# Hot wallet that holds the reward tokens + a little SOL for fees and recipients' token-account rent.
# JSON array (solana-keygen format) or base58 secret key. Keep only what you can afford to lose in it.
TREASURY_SECRET_KEY=
